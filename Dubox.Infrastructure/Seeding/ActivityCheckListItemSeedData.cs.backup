    private static void AddChecklistItemForActivity(
        List<ActivityCheckListItem> items,
        Guid activityMasterId,
        int checklistNumber,
        int? partNumber,
        int sequence,
        string description)
    {
        // Generate a deterministic GUID based on activity and sequence
        var guidString = $"{activityMasterId:N}{sequence:D3}";
        var guidBytes = System.Text.Encoding.UTF8.GetBytes(guidString);
        var hash = System.Security.Cryptography.MD5.HashData(guidBytes);
        var itemId = new Guid(hash);
        
        // For now, we'll create a predefined checklist item ID based on checklist number and part
        // In reality, these should match actual PredefinedChecklistItem records
        var predefinedId = GeneratePredefinedChecklistItemId(checklistNumber, partNumber);
        
        items.Add(new ActivityCheckListItem
        {
            ActivityCheckListItemId = itemId,
            ActivityMasterId = activityMasterId,
            ActivityTemplateActivityId = null,
            PredefinedChecklistItemId = predefinedId,
            Sequence = sequence,
            IsMandatory = true, // All items from client data appear to be mandatory
            IsActive = true,
            CreatedDate = new DateTime(2024, 11, 1, 0, 0, 0, DateTimeKind.Utc),
            CreatedBy = "System"
        });
    }
    
    private static Guid GeneratePredefinedChecklistItemId(int checklistNumber, int? partNumber)
    {
        // Generate deterministic GUID for predefined checklist item
        // Format: Checklist number (2 digits) + Part number (3 digits, 000 if null)
        var key = $"CHK{checklistNumber:D2}P{partNumber?.ToString("D3") ?? "000"}";
        var guidBytes = System.Text.Encoding.UTF8.GetBytes(key);
        var hash = System.Security.Cryptography.MD5.HashData(guidBytes);
        return new Guid(hash);
    }
    
    /// <summary>
    /// Seeds PredefinedChecklistItems for activity inspections
    /// These are the base checklist items that will be referenced by ActivityCheckListItem
    /// </summary>
    private static void SeedPredefinedChecklistItemsForActivities(ModelBuilder modelBuilder, DateTime seedDate)
    {
        var predefinedItems = new List<PredefinedChecklistItem>();
        
        // Create PredefinedChecklistItem for each unique checklist number and part combination
        var checklistDefinitions = new Dictionary<(int checklistNumber, int? partNumber), string>
        {
            // Checklist 1 - Precast Assembly Inspections
            {(1, 1), "Installation of Precast Wall Elements for Modular Box"},
            {(1, 2), "Floor Slab Erection and Mechanical & Wet Connections of Precast Elements"},
            {(1, 3), "Toilet Pod Installation during Assembly"},
            {(1, null), "Construction of Precast Concrete Modular Final Inspection (Assembly)"},
            
            // Checklist 2 - MEP Cage
            {(2, null), "MEP modular installation consisting FCU and HVAC Ducting accessories"},
            
            // Checklist 3 - Electrical Conduits
            {(3, null), "Connection of Electrical Conduits between Precast Walls & Slab"},
            
            // Checklist 4 - Painting (Multiple parts)
            {(4, 1), "Surface Preparation for Paint"},
            {(4, 2), "Application of Primer for Internal Paint"},
            {(4, 3), "Application of Stucco for Internal Paint"},
            {(4, 4), "Application of Internal paint Final Coat"},
            {(4, 5), "Application of Primer for external Paint"},
            {(4, 6), "Application of Filler Coat for external Paint"},
            {(4, 7), "Application of External Final Coat Paint"},
            
            // Checklist 5 - Drainage
            {(5, null), "Installation & Leak Test of Drainage pipes"},
            
            // Checklist 6 - Tile Work
            {(6, 1), "Surface Preparation for Floor Tiles"},
            {(6, 2), "Installation of Floor/Wall Tile Layout"},
            {(6, 3), "Installation & Grouting of Floor/Wall Tiles"},
            
            // Checklist 7 - Water Supply
            {(7, null), "Installation & Pressure Test of water Supply pipes"},
            {(7, 1), "Insulation of hot water pipe"},
            
            // Checklist 8 - Fire Fighting
            {(8, null), "Installation & Pressure Test of fire fighting pipe"},
            
            // Checklist 9 & 10 - Chilled Water/Copper
            {(9, null), "Installation & Pressure Test of Chilled Water Pipes (Copper)"},
            {(10, null), "Installation & Pressure Test of refrigeration pipes (Copper)"},
            
            // Checklist 11 - Damproofing
            {(11, null), "Application of Damproofing"},
            
            // Checklist 12 - HVAC Duct
            {(12, null), "Installation of HVAC Duct with Flexible & Plenum Box"},
            
            // Checklist 13 - Electrical Wiring
            {(13, null), "Pulling of wires and cables through embedded pipes"},
            
            // Checklist 14 - Dry Wall
            {(14, 1), "Installation of Dry Wall Framing"},
            {(14, 2), "Final inspection of Dry Wall Installation"},
            
            // Checklist 15 - Fire Alarm
            {(15, null), "Pulling of Fire Alarm Cables"},
            
            // Checklist 16 - Data/ONU
            {(16, null), "ONU installation along with conduit connection"},
            {(16, 1), "Pulling of Data Cables"},
            
            // Checklist 17 - Fire Sealing
            {(17, null), "Inspection of Fire Sealing Work"},
            
            // Checklist 18 - False Ceiling
            {(18, 1), "Installation of Suspension System of False Ceiling"},
            {(18, 2), "Installation & closing of False Ceiling Gypsum Board/Tiles"},
            
            // Checklist 19 - Waterproofing
            {(19, 1), "Surface Preparation for Wet Area Waterproofing"},
            {(19, 2), "Application & Leak test of Wet Area Waterproofing"},
            
            // Checklist 20 - DB Panel
            {(20, null), "DB installation along with conduit connection"},
            
            // Checklist 21 - Epoxy Flooring
            {(21, 1), "Surface preparation of Epoxy Flooring"},
            {(21, 2), "Application of Epoxy Flooring"},
            
            // Checklist 22 - Electrical Testing
            {(22, null), "Megger and Continuity test of Wires & Cables"},
            
            // Checklist 23 - Kitchen Cabinets
            {(23, 1), "Installation of Kitchen Cabinets & Kitchen Counter Top"},
            
            // Checklist 24 - Wardrobes
            {(24, null), "Installation of Wardrobes"},
            
            // Checklist 25 - Doors
            {(25, null), "Installation of Wooden Doors/Metal Door"},
            
            // Checklist 27 - Sanitary Kitchen
            {(27, null), "Installation of kitchen sink and accessories"},
            
            // Checklist 28 - Access Control
            {(28, null), "Installation of Access Control System"},
            
            // Checklist 29 - Windows
            {(29, null), "Installation of Aluminum Windows/Curtain Wall"},
            
            // Checklist 30 - DX Split Unit
            {(30, null), "Installation DX Split Unit"},
            
            // Checklist 31 - Re-pressure Test
            {(31, null), "Re-pressure test of water supply pipes inside the box"},
            
            // Checklist 32 - Final Inspections (Multiple parts for various MEP items)
            {(32, null), "Final MEP Inspection / Riser Installation"},
            {(32, 1), "Installation of sprinklers / grills and diffusers"},
            {(32, 2), "Installation of smoke detectors and heat detectors"},
            {(32, 3), "Installation of light fittings and accessories"},
            {(32, 4), "Installation of wiring devices and accessories"},
            {(32, 5), "Installation of thermostat"},
            {(32, 6), "Installation of occupancy sensor"},
            
            // Checklist 33 - Final Civil Inspection
            {(33, null), "Final Civil/Architectural Inspection of Modular Box Prior to dispatch"}
        };
        
        foreach (var (key, description) in checklistDefinitions)
        {
            var (checklistNumber, partNumber) = key;
            var itemId = GeneratePredefinedChecklistItemId(checklistNumber, partNumber);
            
            predefinedItems.Add(new PredefinedChecklistItem
            {
                PredefinedItemId = itemId,
                Description = description,
                Reference = $"Checklist {checklistNumber}" + (partNumber.HasValue ? $" Part {partNumber}" : ""),
                Sequence = checklistNumber * 100 + (partNumber ?? 0),
                IsActive = true,
                CreatedDate = seedDate
            });
        }
        
        modelBuilder.Entity<PredefinedChecklistItem>().HasData(predefinedItems);
    }
}

